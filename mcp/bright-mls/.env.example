# Bright MLS RESO Web API credentials — issued by Bright at API onboarding.
# Never commit real values. Test credentials do not work against production.
BRIGHT_MLS_CLIENT_ID=
BRIGHT_MLS_CLIENT_SECRET=

# "test" (default) or "production". Picks both the token URL and the service root.
BRIGHT_MLS_ENV=test

# Only if Bright tells you your app must request a scope.
# BRIGHT_MLS_SCOPE=

# Only if Bright moves a host or issues you a tenant-specific one.
# BRIGHT_MLS_BASE_URL=
# BRIGHT_MLS_TOKEN_URL=

# "basic" (default) or "post" — how the client credentials are sent to Okta.
# The server falls back to the other method automatically on invalid_client.
# BRIGHT_MLS_TOKEN_AUTH=basic

# Tuning.
# BRIGHT_MLS_PAGE_SIZE=100
# BRIGHT_MLS_MAX_PAGES=5
# BRIGHT_MLS_TIMEOUT_MS=30000
# BRIGHT_MLS_DEBUG=1
