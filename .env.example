# Supabase — leads database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — seller follow-up email (optional in v1; lead intake works without it)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_FROM=

# Bright MLS RESO Web API — read-only MCP server (mcp/bright-mls).
# Issued by Bright at API onboarding; test credentials do not work in production.
# Run `cd mcp/bright-mls && npm install && npm run build` before the server will start.
BRIGHT_MLS_CLIENT_ID=
BRIGHT_MLS_CLIENT_SECRET=
BRIGHT_MLS_ENV=test
